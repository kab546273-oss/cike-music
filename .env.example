# ============================================================
# 此刻音乐 — Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# ============================================================

# LLM API Key (required for natural language parsing)
# This key stays server-side only and is never exposed to the browser.
LLM_API_KEY=your_api_key_here

# LLM Model name (e.g. gpt-4o-mini, claude-3-5-sonnet, doubao-pro-32k)
LLM_MODEL=gpt-4o-mini

# LLM API Base URL (optional — override for compatible providers)
# e.g. https://api.openai.com/v1, https://api.anthropic.com, https://ark.cn-beijing.volces.com/api/v3
LLM_API_BASE_URL=https://api.openai.com/v1

# LLM request timeout in milliseconds (optional, default 8000)
LLM_TIMEOUT_MS=8000

# Minimum confidence threshold — below this, fallback to scene picker (0~1)
LLM_MIN_CONFIDENCE=0.5

# Send `thinking: { type: "disabled" }` with the request.
# Volcengine Ark needs it; the public OpenAI endpoint rejects the
# parameter with a 400. Defaults to true for Ark base URLs, false
# otherwise — set it explicitly to override.
# LLM_DISABLE_THINKING=true
